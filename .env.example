# Browser-safe values only. Existing REACT_APP names remain compatible with Vite.
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server only. Never prefix these names with REACT_APP_ or VITE_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Choose a chat provider. Existing OPENAI_API_KEY=gsk_... remains supported.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Separate OpenAI embedding credential; required for vector RAG even with Groq chat.
# Embedding model: text-embedding-3-small, 1536 dimensions.
EMBEDDING_API_KEY=

# This project runs a payment simulation, never a real money transfer.
MAYA_SANDBOX_OTP=123456

# Optional actual hosted Maya sandbox (server-only). No production endpoint is used.
MAYA_PUBLIC_KEY=
MAYA_SECRET_KEY=
APP_BASE_URL=http://127.0.0.1:5173
